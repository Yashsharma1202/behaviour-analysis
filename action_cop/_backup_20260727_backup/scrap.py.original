import os
import re
import time
import requests
import pandas as pd
from datetime import datetime

# Headers to mimic modern browser request to NSE
HEADERS = {
    "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 "
                  "(KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36",
    "Accept": "*/*",
    "Accept-Language": "en-US,en;q=0.9",
    "Referer": "https://www.nseindia.com/companies-listing/corporate-filings-announcements",
}

OUTPUT_DIR = r"d:\action_coop\output_excels"

def get_session():
    """Create a persistent requests Session initialized with NSE cookies."""
    session = requests.Session()
    try:
        session.get("https://www.nseindia.com", headers=HEADERS, timeout=10)
        time.sleep(1)
        session.get("https://www.nseindia.com/companies-listing/corporate-filings-announcements", headers=HEADERS, timeout=10)
        time.sleep(1)
    except Exception as e:
        print(f"[WARN] Session initialization warning: {e}")
    return session

def fetch_json(session, url, params=None, retries=3, delay=0.3):
    """Safely fetch JSON from NSE API with retry and session warming."""
    for attempt in range(retries):
        try:
            resp = session.get(url, headers=HEADERS, params=params, timeout=12)
            if resp.status_code == 200:
                try:
                    return resp.json()
                except Exception:
                    return None
            elif resp.status_code in [401, 403]:
                # Session expired, re-warm
                session = get_session()
        except Exception:
            pass
        time.sleep(delay)
    return None

def fetch_symbol_wise(session, url_template, symbols, symbol_map, key_in_resp=None, delay=0.2):
    """Utility to iterate through symbols and aggregate results."""
    aggregated = []
    for i, sym in enumerate(symbols):
        url = url_template.format(symbol=sym)
        data = fetch_json(session, url, delay=delay)
        if data:
            if key_in_resp and isinstance(data, dict) and key_in_resp in data:
                items = data[key_in_resp]
            elif isinstance(data, list):
                items = data
            elif isinstance(data, dict):
                items = [data]
            else:
                items = []
                
            for item in items:
                if isinstance(item, dict):
                    if "symbol" not in item and "Symbol" not in item:
                        item["symbol"] = sym
                    if "company_name" not in item and "Company Name" not in item:
                        item["company_name"] = symbol_map.get(sym, sym)
                    aggregated.append(item)
        
        # Periodic re-warm session
        if (i + 1) % 25 == 0:
            session = get_session()
        time.sleep(delay)
    return pd.DataFrame(aggregated) if aggregated else pd.DataFrame()

def clean_dataframe(df):
    """Clean DataFrame by stripping whitespace and handling dictionary/list columns."""
    if df is None or df.empty:
        return df
    
    # Drop completely empty columns
    df = df.dropna(how='all', axis=1)
    
    # Convert list/dict objects to string representation for Excel compatibility
    for col in df.columns:
        df[col] = df[col].apply(lambda x: str(x) if isinstance(x, (dict, list)) else x)
    return df

def save_to_excel(df, filename, category_name, dedupe_subset=None):
    """Save/append a DataFrame to a styled Excel file with smart deduplication."""
    os.makedirs(OUTPUT_DIR, exist_ok=True)
    filepath = os.path.join(OUTPUT_DIR, filename)
    
    df = clean_dataframe(df)

    # Read existing Excel file if present to append historical data
    if os.path.exists(filepath):
        try:
            existing_df = pd.read_excel(filepath)
            existing_df = clean_dataframe(existing_df)
            
            # Filter out placeholder messages from existing file
            if "Message" in existing_df.columns:
                existing_df = existing_df[~existing_df["Message"].astype(str).str.contains("No records found", na=False)]
            
            if df is not None and not df.empty:
                if "Message" in df.columns:
                    df = df[~df["Message"].astype(str).str.contains("No records found", na=False)]
                
                if not df.empty and not existing_df.empty:
                    combined_df = pd.concat([existing_df, df], ignore_index=True)
                elif not existing_df.empty:
                    combined_df = existing_df
                else:
                    combined_df = df
            else:
                combined_df = existing_df

            if not combined_df.empty:
                if dedupe_subset:
                    valid_subset = [c for c in dedupe_subset if c in combined_df.columns]
                    if valid_subset:
                        combined_df = combined_df.drop_duplicates(subset=valid_subset, keep="last")
                    else:
                        combined_df = combined_df.drop_duplicates(keep="last")
                else:
                    combined_df = combined_df.drop_duplicates(keep="last")
                df = combined_df
        except Exception as e:
            print(f"[WARN] Could not merge with existing {filename}: {e}")

    if df is None or df.empty:
        df = pd.DataFrame([{"Message": f"No records found on NSE for {category_name}."}])
    else:
        if len(df.columns) > 1 and "Message" in df.columns:
            df = df.drop(columns=["Message"])

    for attempt in range(3):
        try:
            with pd.ExcelWriter(filepath, engine="openpyxl") as writer:
                df.to_excel(writer, sheet_name=category_name[:31], index=False)
                worksheet = writer.sheets[category_name[:31]]
                
                # Auto-adjust column widths
                for col in worksheet.columns:
                    max_len = max(len(str(cell.value or '')) for cell in col)
                    col_letter = col[0].column_letter
                    worksheet.column_dimensions[col_letter].width = min(max(max_len + 3, 12), 60)
            print(f"[SUCCESS] Saved {len(df)} total accumulated rows to {filepath}")
            return filepath
        except PermissionError:
            time.sleep(1.0)
            if attempt == 2:
                print(f"[WARN] Could not save {filename} due to file lock. File may be open in Excel.")
        except Exception as e:
            print(f"[WARN] Could not save {filename}: {e}")
            break
    return None



def load_nifty50_symbols(csv_path=r"d:\action_coop\ind_nifty50list.csv"):
    """Load Nifty 50 constituents from local CSV."""
    df = pd.read_csv(csv_path)
    symbols = df["Symbol"].str.strip().tolist()
    symbol_map = dict(zip(df["Symbol"].str.strip(), df["Company Name"].str.strip()))
    isin_map = dict(zip(df["Symbol"].str.strip(), df["ISIN Code"].str.strip()))
    return symbols, symbol_map, isin_map

